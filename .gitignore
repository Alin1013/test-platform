/.superpowers
# 文档目录：本地文档不入库
/docs/
/.playwright-cli
/.worktrees/
/.venv/
# 临时目录：本地工作产物不入库，避免打包资源过载
/.tmp/

# Python 缓存与本地运行数据
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
/backend/test_platform.db
# 产物目录：UI 自动化产物（截图/录屏/Trace）保存在本地，不入库以避免体积膨胀
/backend/uploads/
/backend/logs/

# 依赖、缓存与生成报告（node_modules 不入库，避免打包资源过载）
/frontend/node_modules
/frontend/dist
/frontend/.vite
/frontend/playwright-report
/frontend/test-results
# 前端 e2e 产物（截图/Trace）保存在本地，不入库
/frontend/output
/output/
node_modules/
*.tsbuildinfo
.eslintcache

# 本地配置、日志、编辑器与操作系统文件
.env
.env.*
!.env.example
*.log
.DS_Store
.idea/
.vscode/

# 数据库相关文档
DATABASE.md
